{
  "manifest_version": 3,
  "name": "Sale Sniper — Auto-Buy for Amazon & Flipkart",
  "short_name": "Sale Sniper",
  "version": "1.0.0",
  "description": "Record your sale wishlist. Sale Sniper waits for Buy Now to go live and checks out for you on Amazon.in & Flipkart.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sale Sniper",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "src/dashboard/dashboard.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://amazon.in/*",
    "https://www.flipkart.com/*",
    "https://flipkart.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://amazon.in/*"],
      "js": ["src/content/common.js", "src/content/amazon.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.flipkart.com/*", "https://flipkart.com/*"],
      "js": ["src/content/common.js", "src/content/flipkart.js"],
      "run_at": "document_idle"
    }
  ]
}
