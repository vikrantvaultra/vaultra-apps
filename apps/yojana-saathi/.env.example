# Optional. Without these the app runs fully on localStorage and sign-in is hidden.
# Supabase project → Settings → API. Run supabase/schema.sql once in the SQL editor,
# and enable the Email provider (Authentication → Providers) with "Email OTP".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL used for canonical links, sitemaps and share links
NEXT_PUBLIC_SITE_URL=https://vaultra-apps.vercel.app/yojana-saathi

# Optional: shown on /contact. Leave empty to show only the contact form.
NEXT_PUBLIC_CONTACT_EMAIL=
